# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Telegram Channel ID(s) — Bir nechta kanal bo'lsa, vergul bilan ajrating:
# Masalan: TELEGRAM_CHANNEL_ID=-1002503816147, -1004392416434, -1002202639176
TELEGRAM_CHANNEL_ID=@your_channel_or_id
# Admin Telegram ID(s) — Bir nechta admin bo'lsa, vergul yoki probel bilan ajratib yozing:
# Masalan: ADMIN_TELEGRAM_ID=6534784826, 123456789, 987654321
ADMIN_TELEGRAM_ID=your_admin_telegram_user_id
ADMIN_TELEGRAM_IDS=
# AI Configuration (Google Gemini Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# Database Configuration (SQLite default, PostgreSQL ready)
DATABASE_URL=sqlite+aiosqlite:///./mlbb_news.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mlbb_news

# Official & Tournament Source URLs
MLBB_SOURCE_URL=https://m.mobilelegends.com
MPL_ID_SOURCE_URL=https://id-mpl.com
MPL_PH_SOURCE_URL=https://ph-mpl.com
ESPORTS_SOURCE_URL=https://liquipedia.net/mobilelegends

# Publishing Mode
# false = Admin Approval Mode (Recommended for MVP to prevent hallucination/errors)
# true  = Auto Mode (Directly publish to channel)
AUTO_PUBLISH=false
APPROVAL_TIMEOUT_MINUTES=30

# MLBB Fun Content, Lore & Memes (every 5 hours)
FUN_POSTS_ENABLED=true
FUN_POSTS_INTERVAL_HOURS=5

# Daily Morning News Schedule (e.g. 05:00 AM Tashkent time, max 5 news items)
DAILY_NEWS_HOUR=5
DAILY_NEWS_MINUTE=0
DAILY_NEWS_TIMEZONE=Asia/Tashkent
MAX_DAILY_NEWS_COUNT=5
NEWS_MAX_AGE_HOURS=24

# Live Match Check Interval (in minutes, checks frequently for upcoming & finished matches)
CHECK_INTERVAL_MPL_ID_MIN=5
CHECK_INTERVAL_MPL_PH_MIN=5

# Reliability & Quality Thresholds
MIN_RELIABILITY_SCORE=80
MIN_CONFIDENCE_SCORE=0.80

# Logging
LOG_LEVEL=INFO
